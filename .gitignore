# Build output
bin/
dist/
*.exe
*.test

# Secrets and local configuration. config.yaml is a server config that may hold
# a connection string; .env holds a database password.
.env
config.yaml
!config.example.yaml
deploy/config.yaml

# Backups written by `dkm connect` before it touches an agent config
*.bak

# Database dumps contain everything
*.dump
*.sql.gz

# Client state: the API key, the local mirror, and any queued writes
.dkm/

# Python sidecar
__pycache__/
venv/
.venv/
*.pyc

# Editors and platforms
.DS_Store
.idea/
.vscode/

# Working notes, per the build plan's instruction to park out-of-scope findings
NOTES.md

# Agent tooling scratch directories.
#
# Some AI coding tools write session state into the project directory under a
# UUID name. One of those — a claude-mem SQLite database and its export — was
# swept into this repository by a `git add -A` and pushed publicly before being
# caught. It contained conversation history from unrelated work.
#
# These patterns exist so that cannot recur. Anything matching them is scratch
# belonging to a tool, never to this project.
[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*/
scratchpad/
claude-mem-*
.claude/
.aider*
.cursor/
