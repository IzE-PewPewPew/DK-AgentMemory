# Copy to .env. This file holds credentials — it is gitignored, keep it that way.

# --- required ---------------------------------------------------------------

# The database password. Generate one rather than choosing one:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# How clients reach this server. Used in the device-code login flow and printed
# by `dkm doctor`, so it must be the externally visible URL, not localhost.
DKM_PUBLIC_URL=https://memories.example.com

# --- optional ---------------------------------------------------------------

POSTGRES_USER=dkm
POSTGRES_DB=dkm

# Host port for the API. Bound to 127.0.0.1 regardless; put a proxy in front.
DKM_PORT=8090

# Image tag. Pin this to a release for anything you rely on.
DKM_VERSION=latest

# Embedding model. Changing it usually changes the vector width, which means
# updating embedding.dimensions and re-embedding the corpus — it is not a
# config-only change.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- consolidation ----------------------------------------------------------
#
# Off by default, because turning it on spends money on an API you have to
# choose. Without it, memories are stored and searchable but never distilled
# into lessons.

DKM_CONSOLIDATION_ENABLED=false
DKM_LLM_PROVIDER=anthropic
DKM_LLM_MODEL=claude-haiku-4-5
DKM_LLM_API_KEY=
